{
  "name": "tsassethover",
  "publisher": "chentp0601",
  "displayName": "TSAssetHover",
  "description": "Preview TypeScript string-literal asset paths and open referenced workspace files from hover.",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/giveyousomecolorlooklook/TSAssetHover.git"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "typescript",
    "assets",
    "hover",
    "image-preview",
    "warcraft",
    "blp",
    "tga"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onCommand:extension.openFile",
    "onCommand:extension.sendAssetContextToChatGPT"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.openFile",
        "title": "Open Referenced Asset File",
        "category": "TSAssetHover"
      },
      {
        "command": "extension.sendAssetContextToChatGPT",
        "title": "Send Referenced Asset File to ChatGPT",
        "category": "TSAssetHover"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "extension.openFile",
          "when": "false"
        },
        {
          "command": "extension.sendAssetContextToChatGPT",
          "when": "false"
        }
      ]
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "TSAssetHover resolves and reads files from the local workspace file system."
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.118.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
